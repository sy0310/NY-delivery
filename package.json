{
  "name": "ny-delivery-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "test:coverage": "node --import ./tests/register-typescript.mjs --experimental-test-coverage --test tests/*.test.mjs",
    "build": "python3 scripts/build.py",
    "start": "python3 scripts/serve.py",
    "doctor": "python3 scripts/doctor.py"
  },
  "engines": { "node": ">=22.18" }
}
